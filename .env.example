# ── Server ────────────────────────────────────────────────────────────────────
HTTP_PORT=8080
LOG_LEVEL=info

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=apm
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
DISABLE_CLICKHOUSE=false        # set true for dev without ClickHouse

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_ENABLED=false             # set true to consume spans.error topic
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=spans.error
KAFKA_GROUP_ID=javi-forecast

# ── Forecasting ───────────────────────────────────────────────────────────────
FORECAST_HORIZON_MINUTES=30     # predict 30 min into the future
FORECAST_INTERVAL_SECONDS=60    # run forecast every 60 s
FEATURE_WINDOW_MINUTES=60       # use last 60 min of data as input
MIN_DATA_POINTS=10              # need at least 10 points before forecasting
DEFAULT_MODEL=auto              # ewma | arima | holtwinters | auto

# ── Backfill ──────────────────────────────────────────────────────────────────
BACKFILL_ENABLED=true           # load ClickHouse history on startup
BACKFILL_HOURS=24               # hours of history to load

# ── Alerting ──────────────────────────────────────────────────────────────────
ALERT_FORECAST_THRESHOLD=2.0    # Z-score threshold for forecast anomaly alerts
ALERT_WEBHOOK_URL=              # POST target for generic webhook alerts
ALERT_SLACK_WEBHOOK_URL=        # Slack incoming webhook URL
